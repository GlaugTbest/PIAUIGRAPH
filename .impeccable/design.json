  "narrative": {
    "northStar": "A precise geographic investigation workspace",
    "overview": "The implemented world follows the user-pinned direction: a wine masthead, paper-light workspace, Times-like titles and a map that opens directly into public records. Territory selection connects the geographic view to the contextual evidence panel. Portuguese labels, source links and coverage statements are part of the working interface.\n\nThe character is compact, restrained and documentary. Tinos gives names, headings and figures an editorial voice; Arial carries controls and dense supporting text. Thin separators and pale tonal surfaces organize information with little visual elevation. Red marks selection and action, never guilt.",
    "keyCharacteristics": [
      "Map-first navigation with a contextual evidence panel.",
      "Wine accents on paper and white surfaces.",
      "Tinos headings and figures paired with Arial controls and supporting text.",
      "Compact controls, thin rules and small corner radii.",
      "Visible coverage, limitations and official evidence."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Wine denotes selected scope and available actions; it never asserts fraud or irregularity.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Use Tinos for headings, record titles and prominent figures; keep dense controls and supporting text in the implemented sans-serif stack.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep permanent map and evidence surfaces flat; use the existing shadow to distinguish the floating search results.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do open directly into the geographic workspace and retain equivalent list access.",
      "Do use the implemented wine, paper and white roles, with Tinos headings and visible focus.",
      "Do keep coverage, insufficient data and official-source actions in the evidence flow.",
      "Do preserve complete period labels and the mobile panel's normal document flow.",
      "Do respect reduced motion when moving the map or scrolling to a record."
    ],
    "donts": [
      "Don't use red selection or graph relationships as visual accusations.",
      "Don't replace thin evidence rows with elevated card grids.",
      "Don't treat a municipality without records in this load as proof of zero procurement.",
      "Don't assume the entire user-requested palette or a serif body has been implemented.",
      "Don't reproduce the smallest provenance text as a default size for new interface content."
    ]
  }
}
